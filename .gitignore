node_modules/
dist/
*.log
.DS_Store
# test-fixtures/ is deliberately NOT ignored: src/check/fixtures.test.ts reads those sample
# repos, so ignoring them made the suite pass locally and fail on every fresh clone (CI).
# The .env inside is a deliberate placeholder for the env-not-ignored rule.
# The precision corpus is local-only. baseline.txt lists which rule fired at which
# file:line in real private projects - no secret values, but a map straight to them -
# and repos.txt leaks local paths and project names. repos.example.txt is committed.
corpus/*
!corpus/repos.example.txt
!corpus/README.md
ROADMAP.md
commit.md
GUIDE.md
OVERVIEW.md
COMMANDS.md
CLAUDE.md
