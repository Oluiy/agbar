{
  "name": "buildquick",
  "version": "0.1.0",
  "description": "Scaffold a backend project, grade an existing one, and practise the engineering concepts behind both - with real pass/fail checks, not quizzes.",
  "type": "module",
  "bin": {
    "buildquick": "./dist/cli.js"
  },
  "files": [
    "dist",
    "content",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node18 --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "license": "MIT",
  "author": "Iyanuoluwa Akinboyewa (Oluiy)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oluiy/aggregator"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "clean-architecture",
    "generator",
    "spring-boot",
    "aspnetcore",
    "backend",
    "learning",
    "system-design",
    "code-quality",
    "best-practices",
    "developer-education"
  ],
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "ignore": "^7.0.9",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
