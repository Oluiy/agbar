{
  "name": "agbar",
  "version": "0.1.0",
  "description": "Grades an existing codebase, and practise the engineering concepts behind both - with real pass/fail checks, not quizzes, also scaffold a backend project.",
  "type": "module",
  "bin": {
    "agbar": "./dist/cli.js"
  },
  "files": [
    "dist",
    "content",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node18 --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "corpus": "node scripts/corpus.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "license": "MIT",
  "author": "Iyanuoluwa Akinboyewa (Oluiy)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oluiy/agbar"
  },
  "homepage": "https://github.com/Oluiy/agbar#readme",
  "bugs": {
    "url": "https://github.com/Oluiy/agbar/issues"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "clean-architecture",
    "generator",
    "spring-boot",
    "aspnetcore",
    "backend",
    "learning",
    "system-design",
    "code-quality",
    "static-analysis",
    "code-review",
    "security",
    "owasp",
    "best-practices",
    "developer-education"
  ],
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "ignore": "^7.0.9",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
